<UserControl x:Class="wpfGMTraceability.UserControls.TraceType3Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfGMTraceability.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local2="clr-namespace:wpfGMTraceability.Helpers"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <Grid Background="Gainsboro">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="80" />
            <RowDefinition Height="45" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5">
            <!-- **** PartNumber Harness + LeadCode + JulianDay **** -->
            <materialDesign:Card x:Name="cardPNLeadJulianDay"  materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="8" BorderThickness="2" Margin="10 5 5 5" BorderBrush="Navy" 
                     Width="auto" Height="auto" Background="Blue">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Width="32" Height="32" Kind="CarShiftPattern" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtScanCode" FontWeight="SemiBold" FontSize="30" Foreground="White" Text="" Margin="2 0 2 0" />
                </StackPanel>
            </materialDesign:Card>
            <!-- **** Count Label **** -->
            <materialDesign:Card x:Name="cardCompCount"  materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="8" BorderThickness="2" Margin="18 5 5 5" BorderBrush="Navy" 
         Width="auto" Height="auto" Background="Blue">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="32" Height="32" Kind="Counter" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtCompCount" FontWeight="SemiBold" FontSize="30" VerticalAlignment="Center" Foreground="White" Text="" Margin="2 0 2 0" />
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
        <!-- Last Scan Label-->
        <TextBlock x:Name="txtLastScan" Text="..." Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" FontSize="18" Foreground="Gray" VerticalAlignment="Top" FontWeight="Normal" Margin="15 0" />
        <!-- **** Cards de escaneos *** -->
        <!-- Primera linea -->
        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="6" Margin="0 2 0 2">
            <materialDesign:Card x:Name="crdComp1" materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="8" 
                     BorderThickness="2" Margin="10 0 0 0" BorderBrush="Gray" Width="auto" Height="auto" Background="WhiteSmoke" Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="32" Height="32" Kind="Number1Box" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtComp1" FontWeight="SemiBold" FontSize="14" Text="CONSTRUCCION-142938905A1-2530922-03-0040707-T" Foreground="Gray" VerticalAlignment="Center" Margin="0 0 5 0" MaxWidth="180" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card x:Name="crdComp2" materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="8"
         BorderThickness="2" Margin="10 0 0 0" BorderBrush="Gray" Width="auto" Height="auto" Background="WhiteSmoke" Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="32" Height="32" Kind="Number2Box" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtComp2" FontWeight="SemiBold" FontSize="14" Text="CONSTRUCCION-142938905A1-2530922-03-0040707-T" Foreground="Gray" VerticalAlignment="Center" Margin="0 0 5 0" MaxWidth="180" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card x:Name="crdComp3" materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="8" 
         BorderThickness="2" Margin="10 0 0 0" BorderBrush="Gray" Width="auto" Height="auto" Background="WhiteSmoke" Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="32" Height="32" Kind="Number3Box" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtComp3" FontWeight="SemiBold" FontSize="14" Text="CONSTRUCCION-142938905A1-2530922-03-0040707-T" Foreground="Gray" VerticalAlignment="Center" Margin="0 0 5 0" MaxWidth="180" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card x:Name="crdComp4" materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="8" 
         BorderThickness="2" Margin="10 0 0 0" BorderBrush="Gray" Width="auto" Height="auto" Background="WhiteSmoke" Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="32" Height="32" Kind="Number4Box" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtComp4" FontWeight="SemiBold" FontSize="14" Text="CONSTRUCCION-142938905A1-2530922-03-0040707-T" Foreground="Gray" VerticalAlignment="Center" Margin="0 0 5 0" MaxWidth="180" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card x:Name="crdComp5" materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="8" 
         BorderThickness="2" Margin="10 0 0 0" BorderBrush="Gray" Width="auto" Height="auto" Background="WhiteSmoke" Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="32" Height="32" Kind="Number5Box" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtComp5" FontWeight="SemiBold" FontSize="14" Text="CONSTRUCCION-142938905A1-2530922-03-0040707-T" Foreground="Gray" VerticalAlignment="Center" Margin="0 0 5 0" MaxWidth="180" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
        <!-- Segunda Linea -->
        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="6" Margin="0 2 0 2">
            <materialDesign:Card x:Name="crdComp6" materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="8" 
             BorderThickness="2" Margin="10 0 0 0" BorderBrush="Gray" Width="auto" Height="auto" Background="WhiteSmoke" Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="32" Height="32" Kind="Number6Box" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtComp6" FontWeight="SemiBold" FontSize="14" Text="CONSTRUCCION-142938905A1-2530922-03-0040707-T" Foreground="Gray" VerticalAlignment="Center" Margin="0 0 5 0" MaxWidth="180" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card x:Name="crdComp7" materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="8" 
 BorderThickness="2" Margin="10 0 0 0" BorderBrush="Gray" Width="auto" Height="auto" Background="WhiteSmoke" Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="32" Height="32" Kind="Number7Box" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtComp7" FontWeight="SemiBold" FontSize="14" Text="CONSTRUCCION-142938905A1-2530922-03-0040707-T" Foreground="Gray" VerticalAlignment="Center" Margin="0 0 5 0" MaxWidth="180" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card x:Name="crdComp8" materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="8" 
 BorderThickness="2" Margin="10 0 0 0" BorderBrush="Gray" Width="auto" Height="auto" Background="WhiteSmoke" Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="32" Height="32" Kind="Number8Box" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtComp8" FontWeight="SemiBold" FontSize="14" Text="CONSTRUCCION-142938905A1-2530922-03-0040707-T" Foreground="Gray" VerticalAlignment="Center" Margin="0 0 5 0" MaxWidth="180" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card x:Name="crdComp9" materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="8" 
 BorderThickness="2" Margin="10 0 0 0" BorderBrush="Gray" Width="auto" Height="auto" Background="WhiteSmoke" Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="32" Height="32" Kind="Number9Box" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtComp9" FontWeight="SemiBold" FontSize="14" Text="CONSTRUCCION-142938905A1-2530922-03-0040707-T" Foreground="Gray" VerticalAlignment="Center" Margin="0 0 5 0" MaxWidth="180" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card x:Name="crdComp10" materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="8" 
 BorderThickness="2" Margin="10 0 0 0" BorderBrush="Gray" Width="auto" Height="auto" Background="WhiteSmoke" Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="32" Height="32" Kind="Number1Box" Foreground="Gray" VerticalAlignment="Center" Margin="0 0 -16 0" />
                    <materialDesign:PackIcon Width="32" Height="32" Kind="Number0Box" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtComp10" FontWeight="SemiBold" FontSize="14" Text="CONSTRUCCION-142938905A1-2530922-03-0040707-T" Foreground="Gray" VerticalAlignment="Center" Margin="0 0 5 0" MaxWidth="180" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
        <!-- **** Video Button **** -->
        <Button x:Name="BtnPlayVideo" Style="{StaticResource MaterialDesignFloatingActionButton}" Height="75" Width="75" BorderBrush="{x:Null}" Background="Gray" Grid.Column="5" Grid.Row="1" Grid.RowSpan="2" Margin="0 0 25 0" Foreground="White" 
HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="BtnPlayVideo_Click">
            <StackPanel Orientation="Vertical">
                <materialDesign:PackIcon Kind="Play" Width="46" Height="46" Foreground="LimeGreen" HorizontalAlignment="Center"/>
                <TextBlock FontWeight="SemiBold" FontSize="16" Text="Video" Margin="0 -5 0 0"/>
            </StackPanel>
        </Button>
        <!-- **** Box Button **** -->
        <Button x:Name="BtnAddBoxes" Style="{StaticResource MaterialDesignFloatingActionButton}" Height="75" Width="75" BorderBrush="{x:Null}" Background="Gray" Grid.Column="5" Grid.Row="3" Grid.RowSpan="2" Margin="0 0 25 0" Foreground="White" 
HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="BtnAddBoxes_Click">
            <StackPanel Orientation="Vertical">
                <materialDesign:PackIcon Kind="BoxAdd" Width="46" Height="46" Foreground="LimeGreen" HorizontalAlignment="Center"/>
                <TextBlock FontWeight="SemiBold" FontSize="16" Text="Material" Margin="0 -5 0 0"/>
            </StackPanel>
        </Button>
        <!--Log de Actividad-->
        <materialDesign:Card Margin="10 10 10 10" Grid.ColumnSpan="4" Grid.Row="5" Grid.RowSpan="6" Grid.Column="0" Padding="0" materialDesign:ElevationAssist.Elevation="Dp8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="Gray" Grid.Row="0" Padding="5" BorderThickness="1" BorderBrush="Black">
                    <TextBlock Text="Log Actividad" Foreground="White" FontWeight="Bold" FontSize="26" VerticalAlignment="Center"/>
                </Border>

                <ListBox x:Name="lbLog" VerticalAlignment="Bottom" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" Grid.Row="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <DockPanel Margin="0" LastChildFill="True" HorizontalAlignment="Stretch">
                                    <materialDesign:PackIcon Kind="{Binding MsjType, Converter={StaticResource TypeToIconConverter}}" Height="60" Width="60" Margin="0" />
                                    <Border Padding="2" CornerRadius="4" Background="{Binding MsjType, Converter={StaticResource TypeToColorConverter}}">
                                        <TextBlock Text="{Binding Formatted}" Foreground="WhiteSmoke" FontSize="24" />
                                    </Border>
                                </DockPanel>
                                <Separator x:Name="sprLine" Margin="2" Background="DarkGray" Height="3" Visibility="{Binding SeparatorVisible}"/>
                            </StackPanel>                            
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </materialDesign:Card>
        <!--DataGrid-->
        <materialDesign:Card Margin="10 10 10 10" Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="5" Grid.RowSpan="5" Padding="0" materialDesign:ElevationAssist.Elevation="Dp8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="Gray" Grid.Row="0" Padding="5" BorderThickness="1" BorderBrush="Black">
                    <TextBlock Text="BOM" Foreground="White" FontWeight="Bold" FontSize="26" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Row="1" CornerRadius="18" BorderThickness="2" ClipToBounds="True" Padding="0" Margin="4 4 4 4">
                    <DataGrid x:Name="dgBOM" AutoGenerateColumns="False" SelectionMode="Single" IsReadOnly="True" Margin="0" Background="LightGray" BorderThickness="0" AlternatingRowBackground="#e1cdfe">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="#6002ee"/>
                                <Setter Property="Foreground" Value="White"/>
                                <!--<Setter Property="HorizontalAlignment" Value="Center" />-->
                            </Style>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Background" Value="WhiteSmoke" />
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.Resources>                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Material" Binding="{Binding BomPart}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="16" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Cant. por Pieza" Binding="{Binding bom_quantity_per_piece}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="18" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Disponible" Binding="{Binding total_available}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="18" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="Suficiente" Binding="{Binding Sufficient}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </materialDesign:Card>
        <!--Logo-->
        <Image Grid.Row="10" Grid.Column="4" Grid.ColumnSpan="2" Margin="0 0 10 0" Width="250" Source="/Resources/LogoWithName.png" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
    </Grid>
</UserControl>